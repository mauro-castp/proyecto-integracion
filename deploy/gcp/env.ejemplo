# env.ejemplo — Plantilla de .env para la nube. instalar_vm.sh crea el .env REAL en la VM con secretos aleatorios (permiso 600).
# NUNCA subas el .env real a Git ni lo pegues en un chat. Aqui van solo nombres y valores de ejemplo, no secretos.

SECRET_KEY=<64 caracteres hexadecimales aleatorios: openssl rand -hex 32>     # la MISMA llave en el portal y en los 23 servicios
POSTGRES_PASSWORD=<32 caracteres aleatorios: openssl rand -hex 16>

# Almacen de archivos: Google Cloud Storage (bucket privado). Sin llaves descargadas: la VM usa su cuenta de servicio.
ALMACEN=gcs
GCS_BUCKET=microhubs-evidencias-637044
URL_FIRMADA_SEGUNDOS=300                   # vigencia de las URLs firmadas de descarga

VERSION_DESPLEGADA=<commit o etiqueta>     # lo que /salud informa como version desplegada
DETRAS_DE_PROXY=1                          # Nginx delante: la IP del cliente sale de X-Forwarded-For (limite por IP y bitacora)

# Solo durante una prueba de carga de capacidad (pruebas_carga/LEEME.md); despues se quitan para volver a 240 y 30:
# LIMITE_POR_MINUTO=1000000
# LIMITE_LOGIN_POR_MINUTO=1000000
