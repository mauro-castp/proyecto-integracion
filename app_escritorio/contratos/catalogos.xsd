      <xs:element name="categoria" type="tns:TCategoria"/>
      <xs:element name="unidad" type="xs:string"/>
      <xs:element name="presentacion" type="xs:string" nillable="true"/>
      <xs:element name="precio">
        <xs:simpleType>
          <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0"/>
