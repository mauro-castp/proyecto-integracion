  </xs:element>
  <xs:element name="reportes_exportaciones">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="tns:TRepExportacionLista">
          <xs:attribute name="version" type="xs:string" use="optional" fixed="1"/>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
</xs:schema>
