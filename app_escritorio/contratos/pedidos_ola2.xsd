        </xs:complexType>
      </xs:element>
      <xs:element name="paginacion" type="tns:TPaginacion"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="TPedVentaProducto">
    <xs:sequence>
      <xs:element name="producto_id" type="xs:long"/>
      <xs:element name="unidades" type="xs:long"/>
      <xs:element name="venta" type="xs:decimal"/>
