  </xs:complexType>
  <xs:complexType name="TPedListosLista">
    <xs:sequence>
      <xs:element name="datos">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="pedido" type="tns:TPedListo" minOccurs="0" maxOccurs="unbounded"/>
