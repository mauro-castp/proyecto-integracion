@startuml
!include tema.iuml
skinparam nodesep 14
skinparam ranksep 20
title Diagrama 3 · Componentes del sistema web (actualizado en el Segundo Parcial)

rectangle "Sistema web empresarial (Flask)" {
  component "**Blueprints públicos**\ncatálogo, cobertura" as PUB
  component "**Autenticación**\nlogin, logout, registro" as AUTH
  component "**Blueprints privados**\ncliente, operación,\nadministración (rutas.py)" as PRIV
  component "**Planeación y web ampliado**\nplaneacion.py · web_ampliado.py\nreportes Highcharts · archivos" as AMP

  component "**@requiere / @protegido**\npermiso y ámbito en CADA ruta\n(nucleo.py)" as MW #F7DCE7

  component "**integracion.py**\ncliente HTTP de los\nmicroservicios (JWT de la sesión)" as INT
  component "**planeacion_calc.py**\ncálculos sin dependencias\n(los reutiliza el servicio)" as CALC

  component "**Acceso a datos**\npsycopg 3 (nucleo.py)" as DAL
  component "Cliente Redis" as CRD
  component "Cliente MongoDB" as CMG
}

rectangle "Microservicios /api/v1" as MS
database "PostgreSQL\n//funciones y triggers//" as PG
database "Redis" as RD
database "MongoDB" as MG

PUB -[hidden]right- AUTH
PRIV -[hidden]right- AMP
PUB -[hidden]down- PRIV
INT -[hidden]right- CALC
DAL -[hidden]right- CRD
CRD -[hidden]right- CMG

PUB --> DAL
AUTH --> CRD : sesión
PRIV --> MW
AMP --> MW
MW --> DAL
AMP --> CALC
AMP --> INT
INT --> MS : HTTP + JWT
AMP --> CMG : bitácora
DAL --> PG
CRD --> RD
CMG --> MG

legend bottom
  RNF23 y HU10 CA2: el decorador es el ÚNICO punto donde se decide el acceso; ocultar una
  opción del menú no cierra la ruta, retirar el permiso sí. Las reglas invariantes (asignación,
  transiciones y auditoría) viven en PostgreSQL como funciones y triggers.
endlegend
@enduml
