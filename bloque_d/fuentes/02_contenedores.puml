@startuml
!include tema.iuml
title Diagrama 2 · Contenedores (entrega final, corregido)
left to right direction

actor "Visitante /\nCliente" as CLI
actor "Operador / Planeador /\nAdministrador / Proveedor" as OPE
actor "Repartidor / Cliente\n(móvil)" as REP

rectangle "Navegador web" as NAV
rectangle "**App Android**\nKotlin · JSON\n//cliente y repartidor//" as AND
rectangle "**App de escritorio**\nC# .NET 8 · XML validado con XSD\n//operador y planeador//" as ESC

rectangle "**Firewall de VPC (GCP)**\nsolo TCP 80 y 443" as FW #F5E3C8
rectangle "**Nginx**\n• Reverse proxy: TLS (HTTPS), X-Forwarded-For\n• API gateway: punto único de entrada, /servicios/<nombre>/ → servicio,\n  límite 20 peticiones/s por IP\n• Balanceo: gunicorn reparte entre los procesos de cada contenedor" as NG #F5E3C8

rectangle "**Portal web (monolito)**\nPython · Flask · Jinja2\n//NO llama a los microservicios//" as WEB #C9DCF0
rectangle "**27 microservicios**\nPython · Flask · /api/v1 · JWT\n//auth · usuarios · productos · pedidos · inventario · entregas//\n//ubicación (facility location) · demanda · cobertura · capacidad (colas)//\n//rutas · costos · punto de equilibrio · simulación · surtido · reportes …//" as MS

database "**PostgreSQL**\noperación, reglas (triggers),\nauditoría, colonias CONAPO" as PG
database "**MongoDB**\nGPS, evidencias (metadatos),\nlogs, simulaciones" as MG
database "**Redis**\nsesiones y revocación JWT,\ncaché, límites" as RD
storage "**Cloud Storage**\narchivos de las apps\n(URL firmadas)" as GCS

CLI --> NAV
OPE --> NAV
OPE --> ESC
REP --> AND

NAV --> FW : HTTPS
AND --> FW : HTTPS · JSON + JWT
ESC --> FW : HTTPS · XML + JWT
FW --> NG
NG --> WEB : / (portal)
NG --> MS : /servicios/<nombre>/

WEB --> PG : SQL
WEB --> RD : sesión, carrito
MS --> PG : SQL (cada servicio sus tablas)
MS --> MG
MS --> RD
MS --> GCS

note bottom of WEB
  El monolito solo apunta a SUS bases de datos.
  Las apps Android y de escritorio son las que
  consumen los microservicios (por el gateway).
end note
@enduml
