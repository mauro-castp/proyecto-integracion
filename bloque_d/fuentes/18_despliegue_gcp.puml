@startuml
!include tema.iuml
title Diagrama 18 · Despliegue en Google Cloud Platform (entrega final, corregido)

actor "Cliente / planeador /\nadministrador (navegador)" as N
actor "Repartidor y cliente\n(app Android, JSON)" as A
actor "Operador / planeador\n(app de escritorio, XML)" as E

cloud "Internet" as I

node "Proyecto integracion-sistemas-637044 · northamerica-south1 (Querétaro)" as P {
  rectangle "IP externa fija microhubs-ip\n34.51.89.253 · 34-51-89-253.sslip.io" as IP
  rectangle "**Firewall de VPC «microhubs-web»**\nentrada solo TCP 80 y 443 (22 por IAP)\nlos puertos 5000 y 5101–5127 no tienen regla" as FW #F5E3C8
  rectangle "**Cloud Load Balancing (HTTPS)** — siguiente paso\nreparte entre 2 o más VMs iguales al crecer\n(hoy hay una sola VM)" as LB #EFEFEF
  node "Compute Engine · microhubs-vm · e2-standard-4 (4 vCPU, 16 GB) · Ubuntu 24.04" as VM {
    rectangle "**Nginx = reverse proxy + API gateway**\nHTTPS (Let's Encrypt) · un solo punto de entrada\n/ → portal · /servicios/<nombre>/ → microservicio\nlímite 20 peticiones/s por IP" as NG #F5E3C8
    node "Docker Compose" as DC {
      rectangle "Portal web (monolito) :5000\ngunicorn, 3 procesos\nsolo habla con PostgreSQL y Redis" as W #C9DCF0
      rectangle "27 microservicios :5101–5127\n1 contenedor c/u · gunicorn reparte\nlas peticiones entre sus procesos" as S
      database "PostgreSQL 16" as PG
      database "MongoDB 7" as MG
      database "Redis 7" as RD
    }
    rectangle "Ops Agent (logs)" as OA
  }
  storage "Cloud Storage (bucket privado)\nevidencias, comprobantes, reportes" as GCS
  rectangle "Cuenta de servicio de la VM\n(sin llaves descargadas)" as SA
  rectangle "Cloud Logging / Monitoring" as CL
}

N --> I : HTTPS
A --> I : HTTPS
E --> I : HTTPS
I --> IP
IP --> FW
FW ..> LB : al escalar
LB ..> NG
FW --> NG : hoy
NG --> W : /
NG --> S : /servicios/<nombre>/
W --> PG
W --> RD
S --> PG
S --> MG
S --> RD
S --> GCS : con la identidad de la VM
S ..> SA : firma URL V4
N ..> GCS : descarga con URL firmada (5 min)
OA --> CL
@enduml
